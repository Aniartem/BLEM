# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Адрес сайта (с https). Нужен для защищённых cookie и кнопки «Открыть CRM» в Telegram
PUBLIC_URL=https://rollevich.ru

# Сервер слушает только локально, наружу его выводит nginx
HOST=127.0.0.1
PORT=3000
# 1 — если сервер стоит за nginx (правильный IP клиента для защиты от спама)
TRUST_PROXY=1

# Где лежит база (по умолчанию ./data/rollevich.db)
# DATA_DIR=/var/lib/rollevich

# Фото сотрудников при отметке смены (по умолчанию ./data/photos) и сколько дней их хранить
# PHOTO_DIR=/var/lib/rollevich/photos
PHOTO_RETENTION_DAYS=90

# Часовой пояс Ижевска (UTC+4) для времени в уведомлениях
TZ_NAME=Europe/Samara

# Telegram: токен бота от @BotFather и ID чатов через запятую.
# ID чата бот пришлёт сам в ответ на /id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
