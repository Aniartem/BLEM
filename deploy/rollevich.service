# systemd: держит сервер РОЛЛЕВИЧ запущенным и поднимает его после перезагрузки.
# Установка: sudo cp deploy/rollevich.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now rollevich
[Unit]
Description=ROLLEVICH: сайт, CRM и Telegram-уведомления
After=network-online.target
Wants=network-online.target

[Service]
User=rollevich
WorkingDirectory=/opt/rollevich
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# Ограничения: сервер пишет только в свою папку с базой
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/rollevich/data

[Install]
WantedBy=multi-user.target
